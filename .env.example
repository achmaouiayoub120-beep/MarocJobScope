# Copy to .env (never commit .env).
# DB_USER, DB_HOST, DB_PORT and DB_NAME are required.
# DB_PASSWORD may be empty only when DB_HOST is localhost or 127.0.0.1
# (trust authentication); otherwise it is required.

DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433
DB_NAME=marocjobscope

# Collectors (optional)
CAREERJET_API_KEY=
CAREERJET_USER_IP=
CAREERJET_REFERER=
REKRUTE_MAX_PAGES=20
REKRUTE_REQUEST_DELAY=2.0
REKRUTE_SLEEP_INTERVAL=86400
